{
  "name": "toon-budget",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "LEDGER",
      "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE"
    }
  ],

  "observability": {
    "enabled": true
  }
}
